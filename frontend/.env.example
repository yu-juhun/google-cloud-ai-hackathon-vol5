# http: Cloud Run APIを利用 / mock: ローカルの固定データを利用
VITE_API_MODE=http

# 検証用backend-api（末尾のスラッシュは不要）
VITE_API_BASE_URL=https://backend-api-378214973378.asia-northeast1.run.app

# Maps JavaScript API / Places API (New)のブラウザ用キー（値はコミットしない）
VITE_GOOGLE_MAPS_API_KEY=

# ローカル開発では公式のデモ用Map IDを使用できる。本番では専用Map IDへ差し替える
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
